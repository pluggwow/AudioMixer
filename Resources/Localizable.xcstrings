    },
    "Строки в панели переставляются перетаскиванием. Автоматически сверху идут те, что играют прямо сейчас.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rows can be reordered by dragging. Automatically, whatever is playing right now comes first."
          }
        }
      }
    },
    "Показывать иконки приложений": {
      "extractionState": "manual",
      "localizations": {
        "en": {
